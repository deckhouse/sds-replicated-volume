@@ -0,0 +1,79 @@
+//go:build unittest
+// +build unittest
+
+package extender
+
+import (
+	"bytes"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+
+	"github.com/libopenstorage/stork/drivers/volume"
+	"github.com/portworx/sched-ops/k8s/core"
+	log "github.com/sirupsen/logrus"
+	kubernetes "k8s.io/client-go/kubernetes/fake"
+	"k8s.io/client-go/tools/record"
+)
+
+// dryRunBody is a request for a pod whose PVC exists neither in Kubernetes nor in
+// the mock driver, so filter and prioritize both reach a scheduling failure.
+func dryRunBody(dryRun string) string {
+	return `{"pod":{"metadata":{"name":"vm","namespace":"default"},` +
+		`"spec":{"volumes":[{"name":"disk","persistentVolumeClaim":{"claimName":"missing"}}]}},` +
+		`"nodes":{"items":[{"metadata":{"name":"node1"}}]}` + dryRun + `}`
+}
+
+// A request with and without dryRun gets the same response; only the request
+// without dryRun records an Event, and only the dry run marks its log lines.
+func TestDryRunSkipsEvent(t *testing.T) {
+	prev := core.Instance()
+	core.SetInstance(core.New(kubernetes.NewSimpleClientset()))
+	t.Cleanup(func() { core.SetInstance(prev) })
+
+	driver, err := volume.Get(mockDriverName)
+	if err != nil {
+		t.Fatalf("Error getting mock volume driver: %v", err)
+	}
+
+	var logs bytes.Buffer
+	prevOut := log.StandardLogger().Out
+	log.SetOutput(&logs)
+	t.Cleanup(func() { log.SetOutput(prevOut) })
+
+	for _, tc := range []struct {
+		verb       string
+		handle     func(*Extender, http.ResponseWriter, *http.Request)
+		wantStatus int
+	}{
+		// PVC lookup fails before the driver is asked.
+		{"filter", (*Extender).processFilterRequest, http.StatusBadRequest},
+		// The driver does not know the PVC; prioritize scores the nodes anyway.
+		{"prioritize", (*Extender).processPrioritizeRequest, http.StatusOK},
+	} {
+		t.Run(tc.verb, func(t *testing.T) {
+			run := func(dryRun string) (*httptest.ResponseRecorder, int, string) {
+				logs.Reset()
+				recorder := record.NewFakeRecorder(10)
+				e := &Extender{Driver: driver, Recorder: recorder}
+				w := httptest.NewRecorder()
+				tc.handle(e, w, httptest.NewRequest(http.MethodPost, "/"+tc.verb, strings.NewReader(dryRunBody(dryRun))))
+				return w, len(recorder.Events), logs.String()
+			}
+
+			normal, normalEvents, normalLog := run("")
+			dry, dryEvents, dryLog := run(`,"dryRun":true`)
+
+			if normal.Code != tc.wantStatus || dry.Code != normal.Code || dry.Body.String() != normal.Body.String() {
+				t.Fatalf("responses differ: normal %d %q, dryRun %d %q", normal.Code, normal.Body, dry.Code, dry.Body)
+			}
+			if normalEvents != 1 || dryEvents != 0 {
+				t.Fatalf("events: normal %d (want 1), dryRun %d (want 0)", normalEvents, dryEvents)
+			}
+			if strings.Contains(normalLog, "dryRun=true") || !strings.Contains(dryLog, "dryRun=true") {
+				t.Fatalf("log of the dry run must carry dryRun=true, the normal one must not:\nnormal: %s\ndryRun: %s", normalLog, dryLog)
+			}
+		})
+	}
+}
