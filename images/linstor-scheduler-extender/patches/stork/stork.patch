+)
+
+func TestFilterResponseRepresentation(t *testing.T) {
+	for _, withVolume := range []bool{false, true} {
+		for _, useNames := range []bool{false, true} {
+			name := "nodes"
+			if useNames {
+				name = "nodeNames"
+			}
+			if withVolume {
+				name += "/filtered"
+			} else {
+				name += "/noPVC"
+			}
+			t.Run(name, func(t *testing.T) {
+				nodes := &v1.NodeList{Items: []v1.Node{
+					{ObjectMeta: metav1.ObjectMeta{Name: "node2"}},
+					{ObjectMeta: metav1.ObjectMeta{Name: "node1"}},
+				}}
+				client := kubernetes.NewSimpleClientset(&nodes.Items[0], &nodes.Items[1])
+				previous := core.Instance()
+				core.SetInstance(core.New(client))
+				t.Cleanup(func() { core.SetInstance(previous) })
+				driver := &mock.Driver{}
+				if err := driver.CreateCluster(2, nodes); err != nil {
+					t.Fatal(err)
+				}
+				pod := &v1.Pod{ObjectMeta: metav1.ObjectMeta{Name: "pod", Namespace: "default"}}
+				wantNames := []string{"node2", "node1"}
+				if withVolume {
+					if err := driver.ProvisionVolume("disk", []int{0}, 1, nil); err != nil {
+						t.Fatal(err)
+					}
+					pvc := driver.NewPVC("disk")
+					pvc.Namespace = pod.Namespace
+					if _, err := core.Instance().CreatePersistentVolumeClaim(pvc); err != nil {
+						t.Fatal(err)
+					}
+					pod.Spec.Volumes = []v1.Volume{{VolumeSource: v1.VolumeSource{PersistentVolumeClaim: &v1.PersistentVolumeClaimVolumeSource{ClaimName: "disk"}}}}
+					if err := driver.UpdateNodeStatus(1, volume.NodeOffline); err != nil {
+						t.Fatal(err)
+					}
+					wantNames = []string{"node1"}
+				}
+				args := schedulerapi.ExtenderArgs{Pod: pod}
+				if useNames {
+					names := []string{"node2", "node1"}
+					args.NodeNames = &names
+				} else {
+					args.Nodes = nodes
+				}
+				body, err := json.Marshal(args)
+				if err != nil {
+					t.Fatal(err)
+				}
